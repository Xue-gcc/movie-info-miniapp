# TMDB v3 API Key. Leave empty to run with the built-in demo data.
VITE_TMDB_API_KEY=

# Domestic media API. The endpoint should be:
# GET {VITE_MEDIA_API_BASE}/movies/{movieId}/trailer
VITE_MEDIA_API_BASE=

# Optional fallback MP4. Leave empty to show "not configured" instead of playing
# an unrelated demo video.
VITE_DEMO_TRAILER_URL=
