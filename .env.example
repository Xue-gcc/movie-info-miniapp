# TMDB v3 API Key. Leave empty to run with the built-in demo data.
VITE_TMDB_API_KEY=

# Domestic media API. The endpoint should be:
# GET {VITE_MEDIA_API_BASE}/movies/{movieId}/trailer
VITE_MEDIA_API_BASE=

# Fallback MP4 used when no domestic media API is configured.
VITE_DEMO_TRAILER_URL=https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/2minute-demo.mp4
